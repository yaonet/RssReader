@page "/"
@page "/articles"
@rendermode InteractiveServer
@using System.Linq.Expressions
@using Microsoft.EntityFrameworkCore
@using RssReader.Models
@using RssReader.ViewModels
@using RssReader.Data
@using RssReader.Services
@using RssReader.Components.Shared
@using RssReader.Components.Articles
@implements IDisposable
@inject IDbContextFactory<RssReaderContext> DbFactory
@inject UpdateNotifier NotificationService
@inject ILogger<Articles> Logger
@inject FeedManager FeedService
@inject ArticleQueryService ArticleQuery

<PageTitle>RssReader</PageTitle>

<AlertDisplay @bind-Alert="_alert" />

<FeedUpdateProgressBar Progress="_updateProgress" IsVisible="_isProcessing" />

<ArticleFilterBar SearchTerm="@_searchTerm"
                  ReadFilter="_readFilter"
                  FavoriteFilter="_favoriteFilter"
                  FilterInfo="@_filterInfo"
                  IsProcessing="_isProcessing"
                  OnSearchTermChanged="HandleSearchTermChanged"
                  OnReadFilterChanged="HandleReadFilterChanged"
                  OnFavoriteFilterChanged="HandleFavoriteFilterChanged"
                  OnClearFilters="ClearFilters"
                  OnMarkAllAsRead="MarkAllAsRead"
                  OnUpdateFeeds="UpdateAllFeeds" />

@if (_isLoadingArticles)
{
    <div class="text-center my-4">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading articles...</span>
        </div>
    </div>
}
else if (_articles.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>No articles yet. Add some feeds to see articles here.
    </div>
}
else
{
    <ArticleGrid Articles="_articles"
                 OnArticleSelected="ShowArticleContent"
                 OnToggleRead="ToggleReadStatus"
                 OnToggleFavorite="ToggleFavoriteStatus" />

    <LoadMoreButton HasMore="_hasMoreArticles"
                    IsLoadingMore="_isLoadingMore"
                    IsDisabled="_isProcessing"
                    CurrentCount="_articles.Count"
                    MinCountToShowTotal="InitialLoadSize"
                    OnLoadMore="LoadMoreArticlesAsync" />
}

<ArticleViewer Article="_selectedArticle"
               IsVisible="@(_selectedArticle != null)"
               OnClose="CloseArticleContent"
               OnToggleRead="HandleToggleReadFromViewer"
               OnToggleFavorite="HandleToggleFavoriteFromViewer" />

@code {
    private const int InitialLoadSize = 100;
    private const int LoadMoreSize = 50;
    private const string FeedNotFoundMessage = "Feed not found";
    private const string CategoryNotFoundMessage = "Category not found";

    private List<ArticleListItem> _articles = [];
    private string _searchTerm = string.Empty;
    private string _filterInfo = string.Empty;
    private int _currentCategoryId = -1;
    private int _currentFeedId = -1;
    private Article? _selectedArticle;
    private Alert? _alert;
    private bool _isLoadingArticles = true;
    private bool _isLoadingMore;
    private bool _hasMoreArticles = true;
    private bool _disposed;
    private bool _isProcessing;
    private ReadFilter _readFilter = ReadFilter.All;
    private FavoriteFilter _favoriteFilter = FavoriteFilter.All;
    private FeedUpdateProgress? _updateProgress;
    private System.Timers.Timer? _debounceTimer;
    private CancellationTokenSource? _cts;

    [SupplyParameterFromQuery(Name = "categoryId")]
    public int? CategoryId { get; set; }

    [SupplyParameterFromQuery(Name = "feedId")]
    public int? FeedId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnFeedsUpdated += HandleFeedsUpdated;
        NotificationService.OnCategoriesUpdated += HandleCategoriesUpdated;
        NotificationService.OnFeedUpdateProgress += HandleFeedUpdateProgress;

        _cts = new CancellationTokenSource();
        _debounceTimer = new System.Timers.Timer(500) { AutoReset = false };
        _debounceTimer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;

            try
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await LoadArticlesAsync();
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException) { }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error in debounce timer elapsed handler");
            }
        };

        await LoadArticlesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var newCategoryId = CategoryId ?? 0;
        var newFeedId = FeedId ?? 0;

        if (_currentCategoryId != newCategoryId || _currentFeedId != newFeedId)
        {
            _currentCategoryId = newCategoryId;
            _currentFeedId = newFeedId;
            _searchTerm = string.Empty;
            _alert = null;
            await LoadArticlesAsync();
        }
    }

    private async Task LoadArticlesAsync()
    {
        try
        {
            _isLoadingArticles = true;
            _hasMoreArticles = true;

            _filterInfo = await BuildFilterInfoAsync();
            if (_filterInfo == FeedNotFoundMessage || _filterInfo == CategoryNotFoundMessage)
            {
                _articles = [];
                _hasMoreArticles = false;
                return;
            }

            var result = await ArticleQuery.GetArticlesAsync(
                feedId: FeedId,
                categoryId: CategoryId,
                isRead: GetReadFilterValue(),
                isFavorite: GetFavoriteFilterValue(),
                searchTerm: _searchTerm,
                take: InitialLoadSize);

            if (result.Success)
            {
                _articles = result.Articles;
                _hasMoreArticles = result.Articles.Count >= InitialLoadSize;
                Logger.LogInformation("Loaded {ArticleCount} articles", _articles.Count);
            }
            else
            {
                Logger.LogError("Failed to load articles: {Error}", result.ErrorMessage);
                _alert = Alert.Error($"Failed to load articles: {result.ErrorMessage}");
                _articles = [];
                _hasMoreArticles = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading articles. CategoryId: {CategoryId}, FeedId: {FeedId}", CategoryId, FeedId);
            _alert = Alert.Error($"Failed to load articles: {ex.Message}");
            _articles = [];
            _hasMoreArticles = false;
        }
        finally
        {
            _isLoadingArticles = false;
        }
    }

    private async Task<string> BuildFilterInfoAsync()
    {
        if (FeedId is > 0)
        {
            var feedInfo = await ArticleQuery.GetFeedFilterInfoAsync(FeedId.Value);
            if (feedInfo == null)
            {
                Logger.LogWarning("Feed with ID {FeedId} not found", FeedId.Value);
                return FeedNotFoundMessage;
            }

            var info = $"Feed: {feedInfo.FeedTitle}";
            if (feedInfo.CategoryName != null)
            {
                info += $" (Category: {feedInfo.CategoryName})";
            }
            return info;
        }

        if (CategoryId is > 0)
        {
            var categoryName = await ArticleQuery.GetCategoryNameAsync(CategoryId.Value);
            if (categoryName == null)
            {
                Logger.LogWarning("Category with ID {CategoryId} not found", CategoryId.Value);
                return CategoryNotFoundMessage;
            }
            return $"Category: {categoryName}";
        }

        return string.Empty;
    }

    private bool? GetReadFilterValue() => _readFilter switch
    {
        ReadFilter.Read => true,
        ReadFilter.Unread => false,
        _ => null
    };

    private bool? GetFavoriteFilterValue() => _favoriteFilter switch
    {
        FavoriteFilter.Favorite => true,
        FavoriteFilter.NonFavorite => false,
        _ => null
    };

    private async Task LoadMoreArticlesAsync()
    {
        if (_isLoadingMore || _isProcessing || !_hasMoreArticles) return;

        try
        {
            _isLoadingMore = true;

            var result = await ArticleQuery.GetArticlesAsync(
                feedId: FeedId,
                categoryId: CategoryId,
                isRead: GetReadFilterValue(),
                isFavorite: GetFavoriteFilterValue(),
                searchTerm: _searchTerm,
                skip: _articles.Count,
                take: LoadMoreSize);

            if (result.Success)
            {
                if (result.Articles.Count != 0)
                {
                    _articles.AddRange(result.Articles);
                    _hasMoreArticles = result.Articles.Count >= LoadMoreSize;
                    Logger.LogInformation("Loaded {Count} more articles, total now {Total}",
                        result.Articles.Count, _articles.Count);
                }
                else
                {
                    _hasMoreArticles = false;
                    Logger.LogInformation("No more articles to load");
                }
            }
            else
            {
                Logger.LogError("Failed to load more articles: {Error}", result.ErrorMessage);
                _alert = Alert.Error($"Failed to load more articles: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading more articles");
            _alert = Alert.Error($"Failed to load more articles: {ex.Message}");
        }
        finally
        {
            _isLoadingMore = false;
        }
    }

    private async Task ShowArticleContent(ArticleListItem articleItem)
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        _selectedArticle = await context.Set<Article>()
            .Include(a => a.Feed)
            .ThenInclude(f => f!.Category)
            .FirstOrDefaultAsync(a => a.Id == articleItem.Id, _cts?.Token ?? default);

        if (_selectedArticle is { IsRead: false })
        {
            await MarkArticleAsRead(articleItem);
        }
    }

    private void CloseArticleContent() => _selectedArticle = null;

    private async Task MarkArticleAsRead(ArticleListItem articleItem)
    {
        await UpdateArticleBoolPropertyAsync(
            articleItem,
            a => a.IsRead,
            true,
            item => item.IsRead = true,
            "read");
    }

    private async Task ToggleReadStatus(ArticleListItem articleItem)
    {
        var newStatus = !articleItem.IsRead;
        await UpdateArticleBoolPropertyAsync(
            articleItem,
            a => a.IsRead,
            newStatus,
            item => item.IsRead = newStatus,
            "read");
    }

    private async Task ToggleFavoriteStatus(ArticleListItem articleItem)
    {
        var newStatus = !articleItem.IsFavorite;
        await UpdateArticleBoolPropertyAsync(
            articleItem,
            a => a.IsFavorite,
            newStatus,
            item => item.IsFavorite = newStatus,
            "favorite");
    }

    private async Task UpdateArticleBoolPropertyAsync(
        ArticleListItem articleItem,
        Expression<Func<Article, bool>> propertySelector,
        bool newValue,
        Action<ArticleListItem> updateListItem,
        string propertyName)
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            await context.Set<Article>()
                .Where(a => a.Id == articleItem.Id)
                .ExecuteUpdateAsync(
                    setters => setters.SetProperty(propertySelector, newValue),
                    _cts?.Token ?? default);

            updateListItem(articleItem);

            if (_selectedArticle?.Id == articleItem.Id)
            {
                var propertyInfo = ((MemberExpression)propertySelector.Body).Member;
                typeof(Article).GetProperty(propertyInfo.Name)?.SetValue(_selectedArticle, newValue);
            }

            Logger.LogInformation("Updated {PropertyName} status for article {ArticleId} to {Value}",
                propertyName, articleItem.Id, newValue);
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Update {PropertyName} operation was cancelled for article {ArticleId}",
                propertyName, articleItem.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update {PropertyName} status for article: {ArticleId}",
                propertyName, articleItem.Id);
            _alert = Alert.Error($"Failed to update {propertyName} status: {ex.Message}");
        }
    }

    private async Task HandleToggleReadFromViewer(Article article)
    {
        var articleItem = _articles.Find(a => a.Id == article.Id);
        if (articleItem != null)
        {
            await ToggleReadStatus(articleItem);
        }
    }

    private async Task HandleToggleFavoriteFromViewer(Article article)
    {
        var articleItem = _articles.Find(a => a.Id == article.Id);
        if (articleItem != null)
        {
            await ToggleFavoriteStatus(articleItem);
        }
    }

    private async void HandleFeedsUpdated()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(async () =>
            {
                await LoadArticlesAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling feeds updated event");
        }
    }

    private async void HandleCategoriesUpdated()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(async () =>
            {
                await LoadArticlesAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling categories updated event");
        }
    }

    private async void HandleFeedUpdateProgress(FeedUpdateProgress progress)
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(() =>
            {
                _updateProgress = progress;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling feed update progress event");
        }
    }

    private void HandleSearchTermChanged(string value)
    {
        _searchTerm = value;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task HandleReadFilterChanged(ReadFilter filter)
    {
        _readFilter = _readFilter == filter ? ReadFilter.All : filter;
        await LoadArticlesAsync();
    }

    private async Task HandleFavoriteFilterChanged(FavoriteFilter filter)
    {
        _favoriteFilter = _favoriteFilter == filter ? FavoriteFilter.All : filter;
        await LoadArticlesAsync();
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _readFilter = ReadFilter.All;
        _favoriteFilter = FavoriteFilter.All;
        _alert = null;
        await LoadArticlesAsync();
    }

    private async Task MarkAllAsRead()
    {
        if (_isProcessing) return;

        try
        {
            _isProcessing = true;

            var count = await ArticleQuery.MarkArticlesAsReadAsync(
                feedId: FeedId,
                categoryId: CategoryId,
                isRead: GetReadFilterValue(),
                isFavorite: GetFavoriteFilterValue(),
                searchTerm: _searchTerm);

            if (count == 0)
            {
                _alert = Alert.Info("No unread articles found matching current filters.");
                return;
            }

            foreach (var article in _articles)
            {
                article.IsRead = true;
            }

            if (_readFilter == ReadFilter.Unread)
            {
                _articles.Clear();
                _hasMoreArticles = false;
            }
            else
            {
                _articles = [.. _articles.OrderBy(a => a.IsRead).ThenByDescending(a => a.PublishDate)];
            }

            _alert = Alert.Success($"Marked {count} article(s) as read.");
            Logger.LogInformation("Marked {Count} articles as read", count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark all articles as read");
            _alert = Alert.Error($"Failed to mark articles as read: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task UpdateAllFeeds()
    {
        if (_isProcessing) return;

        try
        {
            _isProcessing = true;
            _updateProgress = null;
            _alert = Alert.Info("Updating all feeds...");

            var result = await FeedService.UpdateAllFeedsAsync();

            _updateProgress = null;

            await LoadArticlesAsync();

            _alert = (result.SuccessfulUpdates, result.FailedUpdates) switch
            {
                (_, 0) => Alert.Success($"All {result.SuccessfulUpdates} feed(s) updated successfully."),
                (0, _) => Alert.Error($"Failed to update all {result.FailedUpdates} feed(s). Check logs for details."),
                _ => Alert.Warning($"Updated {result.SuccessfulUpdates} feed(s) successfully, but {result.FailedUpdates} feed(s) failed. Check logs for details.")
            };

            Logger.LogInformation("Feed update completed: {Success} successful, {Failed} failed",
                result.SuccessfulUpdates, result.FailedUpdates);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update all feeds");
            _alert = Alert.Error($"Failed to update feeds: {ex.Message}");
            _updateProgress = null;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        NotificationService.OnFeedsUpdated -= HandleFeedsUpdated;
        NotificationService.OnCategoriesUpdated -= HandleCategoriesUpdated;
        NotificationService.OnFeedUpdateProgress -= HandleFeedUpdateProgress;
        _debounceTimer?.Dispose();
    }
}

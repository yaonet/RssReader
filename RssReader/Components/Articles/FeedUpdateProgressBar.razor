@using RssReader.ViewModels

@if (Progress != null && IsVisible)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">
                    <i class="bi bi-arrow-clockwise"></i> Updating Feeds
                </h6>
                <span class="badge bg-primary">@Progress.Percentage%</span>
            </div>
            <div class="progress mb-2" style="height: 25px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" 
                     style="width: @(Progress.Percentage)%"
                     aria-valuenow="@Progress.Percentage" 
                     aria-valuemin="0" 
                     aria-valuemax="100">
                    @Progress.ProcessedFeeds / @Progress.TotalFeeds
                </div>
            </div>
            <div class="d-flex justify-content-between text-muted small">
                <span>
                    @if (!string.IsNullOrEmpty(Progress.CurrentFeedTitle))
                    {
                        <span>Current: @Progress.CurrentFeedTitle</span>
                    }
                </span>
                <span>
                    <span class="text-success me-2">? @Progress.SuccessfulFeeds</span>
                    @if (Progress.FailedFeeds > 0)
                    {
                        <span class="text-danger">? @Progress.FailedFeeds</span>
                    }
                </span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public FeedUpdateProgress? Progress { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }
}
